{
  "name": "openmap-card",
  "version": "1.0.1",
  "description": "Open Map Home Assistant integration frontend card",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint custom_components/openmap/frontend/src/",
    "test": "node --test tests/frontend/*.test.js",
    "test:browser": "npm run build && node tests/browser/build-probe.mjs && playwright test"
  },
  "dependencies": {
    "lit": "^3.1.0",
    "ol": "10.11.0",
    "proj4": "^2.19.10"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@playwright/test": "1.65.1",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "eslint": "^9.0.0",
    "rollup": "^4.0.0"
  }
}
